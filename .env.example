# launchkit environment variables
#
# Copy this file to `.env` (gitignored) and fill in real values.
# launchkit reads from process.env first, then .env / .env.local /
# .env.production / .env.production.local (first match wins).

# Cloudflare API token used by `launchkit domain setup`.
# Create one at https://dash.cloudflare.com/profile/api-tokens with:
#   - Zone   → Read
#   - DNS    → Edit
# scoped to the zone(s) you launch under. Leave unset to skip DNS automation;
# `domain setup` and `e2e` then report the records you must add manually.
CLOUDFLARE_API_TOKEN=
